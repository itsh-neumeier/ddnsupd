    "/records/{id}/create-missing": {
      "post": {
        "summary": "Queue confirmed creation of a missing Hetzner A or AAAA record",
        "description": "Requires records.create and updates.trigger, an active scoped binding and a writable Hetzner primary zone. The job respects cooldowns and fails if the RRSet already exists.",
        "operationId": "post__records__id__create_missing",
        "security": [{"session": []}],
        "parameters": [
          {"in": "path", "name": "id", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"in": "header", "name": "Origin", "required": true, "schema": {"type": "string"}},
          {"in": "header", "name": "X-CSRF-Token", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "202": {"description": "Creation queued"},
          "401": {"description": "Unauthenticated"},
          "403": {"description": "Permission, Origin or CSRF denied"},
