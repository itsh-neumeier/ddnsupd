  "components": {
    "requestBodies": {
      "BackupRestore": {"required": true, "content": {"application/json": {"schema": {
        "type": "object", "required": ["archive", "passphrase", "confirm"], "additionalProperties": false,
        "properties": {
          "archive": {"type": "string", "description": "Hex-encoded DDNSupd archive", "maxLength": 33554432},
          "passphrase": {"type": "string", "minLength": 12, "writeOnly": true},
          "confirm": {"const": true}
        }
      }}}}
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ddnsupd_session"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "writeOnly": true
          }
        }
      },
      "ProviderInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "token"
        ],
        "properties": {
          "kind": {
            "enum": [
              "hetznercloud",
              "cloudflare"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "token": {
            "type": "string",
            "maxLength": 8192,
            "writeOnly": true
          }
        }
      },
      "ProviderEdit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "enabled"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "token": {
            "type": "string",
            "writeOnly": true,
            "description": "Omit to keep stored credential. Never returned."
          }
        }
      },
      "RecordInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_id",
          "zone_remote_id",
          "zone_name",
          "name",
          "record_type"
        ],
        "properties": {
          "provider_id": {
            "type": "string",
            "format": "uuid"
          },
          "zone_remote_id": {
            "type": "string"
          },
          "zone_name": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "Relative owner or @; no implicit remote record creation."
          },
          "record_type": {
            "enum": [
              "A",
              "AAAA"
            ]
          },
          "remote_record_id": {
            "type": "string",
            "description": "Required for Cloudflare"
          },
          "manual_ip": {
            "type": "string",
            "default": "",
            "description": "Empty selects fixed HTTPS family-specific discovery"
          },
          "managed_ip": {
            "type": "string",
            "default": ""
          },
          "active": {
            "type": "boolean",
            "default": false
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "default": 300
          },
          "site": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "RecordEdit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "active",
          "manual_ip",
          "interval_seconds",
          "site"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "manual_ip": {
            "type": "string"
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400
          },
          "site": {
            "type": "string",
            "maxLength": 120
          }
        }
      },
      "Password": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "current",
          "password"
        ],
        "properties": {
          "current": {
            "type": "string",
            "writeOnly": true
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "writeOnly": true
          }
        }
      },
      "NewUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password",
          "role_id"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "writeOnly": true
          },
          "role_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "NewRole": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "permissions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "permissions": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Grant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "enabled"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "provider_id": {
            "type": "string",
            "format": "uuid"
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "description": "Exactly one of provider_id and record_id."
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
