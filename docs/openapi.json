{
  "openapi": "3.1.0",
  "info": {
    "title": "DDNSupd API",
    "version": "0.1.0-dev",
    "description": "Development contract. Cookie mutations require exact configured Origin and per-session X-CSRF-Token. Default list page: 100 records. Provider credentials are never returned. Non-JSON extractor failures can use Axum's plain-text rejection format."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/backup": {
      "post": {
        "summary": "Download an encrypted application snapshot as an administrator",
        "operationId": "post_backup_export",
        "security": [{"session": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "required": ["passphrase"], "additionalProperties": false,
          "properties": {"passphrase": {"type": "string", "minLength": 12, "writeOnly": true}}
        }}}},
        "responses": {
          "200": {"description": "Versioned encrypted archive", "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}},
          "403": {"description": "Permission, Origin or CSRF denied"},
          "413": {"description": "Snapshot too large"},
          "429": {"description": "Another backup operation is in progress"}
        }
      }
    },
    "/backup/restore": {
      "post": {
        "summary": "Replace existing application data as an administrator and end all sessions",
        "operationId": "post_backup_restore",
        "security": [{"session": []}],
        "requestBody": {"$ref": "#/components/requestBodies/BackupRestore"},
        "responses": {
          "200": {"description": "Restored with all records paused"},
          "403": {"description": "Permission, Origin or CSRF denied"},
          "409": {"description": "Database schema version mismatch"},
          "422": {"description": "Invalid archive or passphrase"}
        }
      }
    },
    "/setup/restore": {
      "post": {
        "summary": "Restore a backup on an uninitialized installation",
        "operationId": "post_setup_restore",
        "parameters": [{"in": "header", "name": "X-Setup-Token", "required": true, "schema": {"type": "string"}}],
        "requestBody": {"$ref": "#/components/requestBodies/BackupRestore"},
        "responses": {
          "200": {"description": "Restored with all records paused"},
          "403": {"description": "Setup token or Origin denied"},
          "409": {"description": "Setup already complete or database schema version mismatch"},
          "422": {"description": "Invalid archive or passphrase"}
        }
      }
    },
    "/providers/{id}/discover": {
      "post": {
        "summary": "Read provider zones/records; requires providers.read and provider grant or administrator. Does not verify DNS write permissions.",
        "operationId": "post_provider_discover", "security": [{"session":[]}],
        "parameters": [{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"header","name":"Origin","required":true,"schema":{"type":"string"}},{"in":"header","name":"X-CSRF-Token","required":true,"schema":{"type":"string"}}],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["operation"],"properties":{"operation":{"enum":["zones","records"]},"zone_id":{"type":"string"},"zone_name":{"type":"string"},"page":{"type":"integer","minimum":1,"maximum":10000,"default":1}}}}}},
        "responses":{"200":{"description":"zones, records, page, next_page and permission_verification=read_only"},"400":{"description":"Invalid request"},"403":{"description":"CSRF or permission denied"},"404":{"description":"Provider outside authorized scope"},"422":{"description":"Classified provider error"},"429":{"description":"Persistent discovery budget or provider rate limit"}}
      }
    },
    "/imports/preview": {
      "post": {
        "summary":"Analyze upstream config against existing provider records; administrator only. Raw config/credentials are never persisted. Preview expires after ten minutes.",
        "operationId":"post_import_preview","security":[{"session":[]}],
        "parameters":[{"in":"header","name":"Origin","required":true,"schema":{"type":"string"}},{"in":"header","name":"X-CSRF-Token","required":true,"schema":{"type":"string"}}],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["provider_id","zone_id","zone_name","config"],"properties":{"provider_id":{"type":"string","format":"uuid"},"zone_id":{"type":"string"},"zone_name":{"type":"string"},"config":{"type":"object","required":["settings"],"properties":{"settings":{"type":"array","minItems":1,"maxItems":200,"items":{"type":"object"}}}},"ambiguous_family":{"type":["string","null"],"enum":["A","AAAA",null]},"interval_seconds":{"type":"integer","minimum":60,"maximum":86400,"default":300}}}}}},
        "responses":{"201":{"description":"id, digest, expires_at, normalized plan with per-entry errors/warnings; no source credentials"},"400":{"description":"Invalid source format or options"},"403":{"description":"Requires administrator, records.create and CSRF"},"422":{"description":"Provider error or bounded discovery limit"},"429":{"description":"Rate limit"},"504":{"description":"Preview discovery deadline"}}
      }
    },
    "/imports/{id}/confirm": {
      "post": {
        "summary":"Consume user's preview once; atomically create selected local bindings, always paused. No provider writes.",
        "operationId":"post_import_confirm","security":[{"session":[]}],
        "parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"header","name":"Origin","required":true,"schema":{"type":"string"}},{"in":"header","name":"X-CSRF-Token","required":true,"schema":{"type":"string"}}],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["digest","selected_indices","accept_warnings"],"properties":{"digest":{"type":"string"},"selected_indices":{"type":"array","minItems":1,"maxItems":200,"uniqueItems":true,"items":{"type":"integer","minimum":0}},"accept_warnings":{"const":true}}}}}},
        "responses":{"201":{"description":"created array of index/id and active=false"},"400":{"description":"Missing acknowledgement, invalid selection or conflicted row"},"403":{"description":"Requires administrator and CSRF"},"404":{"description":"Preview is not owned by user"},"409":{"description":"Expired, consumed, modified preview, credential rotation or database conflict; no partial changes"}}
      }
    },
    "/dashboard": {"get":{"summary":"Resource-scoped aggregate counts across all pages","operationId":"get_dashboard","security":[{"session":[]}],"responses":{"200":{"description":"Counts: total_records, verified, attention, zones, active"},"401":{"description":"Unauthenticated"},"403":{"description":"Permission denied"}}}},
